      "url": "https://arxiv.org/abs/2005.11401"
    },
    {
      "term": "CoT",
      "full_name": "Chain-of-Thought",
      "zh": "思维链",
      "plain_explanation": "让模型先逐步推理再作答的提示方式，显著提升复杂问题的准确率",
      "url": "https://arxiv.org/abs/2201.11903"
    },
    {
      "term": "SFT",
      "full_name": "Supervised Fine-Tuning",
      "zh": "监督微调",
      "plain_explanation": "用标注好的指令-回答数据继续训练模型，让模型学会遵循指令",
      "url": "https://arxiv.org/abs/2203.02155"
    },
    {
      "term": "MoE",
      "full_name": "Mixture of Experts",
      "zh": "混合专家",
      "plain_explanation": "把模型拆成多个专家子网络，每次只激活一部分，用更少算力获得更大容量",
      "url": "https://arxiv.org/abs/1701.06538"
    },
    {
