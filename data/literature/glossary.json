    {
      "term": "LLM",
      "full_name": "Large Language Model",
      "zh": "大语言模型",
      "plain_explanation": "在海量文本上预训练的语言模型，可生成与理解自然语言，是当前 Agent 与对话系统的基础",
      "url": "https://arxiv.org/abs/2001.08361"
    },
    {
      "term": "Agent",
      "full_name": "AI Agent / Language Agent",
      "zh": "智能体",
      "plain_explanation": "能自主感知环境、规划行动、调用工具完成任务（如搜索、写代码）的 LLM 系统",
      "url": "https://arxiv.org/abs/2308.11432"
    },
    {
      "term": "RLHF",
      "full_name": "Reinforcement Learning from Human Feedback",
      "zh": "基于人类反馈的强化学习",
      "plain_explanation": "用人类偏好数据训练奖励模型，再用强化学习对齐模型行为，ChatGPT 的核心后训练方法",
      "url": "https://arxiv.org/abs/2203.02155"
    },
    {
      "term": "RLVR",
      "full_name": "Reinforcement Learning with Verifiable Rewards",
      "zh": "基于可验证奖励的强化学习",
      "plain_explanation": "用可自动验证的客观信号（如数学答案、代码测试结果）做奖励，无需人类标注，DeepSeek-R1 等推理模型的后训练范式",
      "url": "https://arxiv.org/abs/2501.12948"
    },
    {
      "term": "Transformer",
      "full_name": "Transformer",
      "zh": "Transformer 架构",
      "plain_explanation": "2017 年提出的注意力机制架构，几乎所有现代大模型的基础",
      "url": "https://arxiv.org/abs/1706.03762"
    },
    {
      "term": "Foundation Model",
      "full_name": "Foundation Model",
      "zh": "基础模型 / 底座模型",
      "plain_explanation": "在大规模数据上预训练、可适配多种下游任务的通用模型",
      "url": "https://arxiv.org/abs/2108.07258"
    },
    {
      "term": "RAG",
      "full_name": "Retrieval-Augmented Generation",
      "zh": "检索增强生成",
